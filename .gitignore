# The sidecar's binaries are not in the repository: they are the assets of
# the sidecar release, which the plugin downloads when it has no binary of
# its own. The ones built by hand or downloaded are local, so they are
# ignored.
sidecar/bin/
dist/

# The code graph of the repository, of the machine that made it: it is of no
# use to anyone else.
.codegraph/
