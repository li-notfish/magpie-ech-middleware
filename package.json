{
  "name": "magpie-ech-middleware",
  "version": "0.3.0",
  "description": "Encrypted Client Hello for magpie: an ECH copy of every provider you wrote, so their traffic goes out with an encrypted client hello",
  "type": "module",
  "main": "./ech.plugin.js",
  "files": [
    "ech.plugin.js",
    "ech.providers.js",
    "ech.shared.js",
    "ech.middleware.js",
    "ech.hooks.js",
    "sidecar.mjs",
    "sidecar/main.go",
    "sidecar/ech.go",
    "sidecar/go.mod",
    "sidecar/bin",
    "scripts/build.mjs",
    "scripts/build-all.mjs",
    "scripts/go.mjs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "keywords": [
    "magpie",
    "magpie-middleware",
    "ech",
    "encrypted-client-hello",
    "tls",
    "privacy"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/li-notfish/magpie-ech-middleware"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:all": "node scripts/build-all.mjs",
    "test": "bun test"
  },
  "magpie": {
    "middleware": "./ech.middleware.js",
    "hooks": "./ech.hooks.js",
    "options": {
      "port": 8790,
      "failClosed": false,
      "log": true
    }
  }
}
